function setting(PDO $pdo, string $key): ?string { $s = $pdo->prepare('SELECT SettingValue FROM SafetyVote_Settings WHERE SettingKey=?'); $s->execute([$key]); $value = $s->fetchColumn(); return $value === false ? null : (string)$value; }
