function reply(array $body, int $status = 200): void { http_response_code($status); echo json_encode($body, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); exit; }
function authorized(string $expected): bool { $token = (string)($_SERVER['HTTP_X_SAFETY_VOTE_RELEASE_TOKEN'] ?? ''); return $token !== '' && hash_equals($expected, hash('sha256', $token)); }
