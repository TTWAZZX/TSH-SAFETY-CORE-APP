    $versionColumns = ['EligibilityEnrollmentMode','EligibilityEnrollmentUpdatedAt','EligibilityEnrollmentUpdatedBy']; $snapshotColumns = ['ParentSnapshotID','SnapshotKind']; $settings = ['schema_version','eligibility_amendment_contract','eligibility_amendment_enabled','eligibility_amendment_default_mode','eligibility_amendment_allowed_modes']; $before = ['businessRows' => business_rows($pdo), 'versionColumns' => column_count($pdo, 'SafetyVote_CampaignVersions', $versionColumns), 'snapshotColumns' => column_count($pdo, 'SafetyVote_EligibilitySnapshots', $snapshotColumns)]; foreach ($settings as $key) $before[$key] = setting($pdo, $key); if (!in_array($before['schema_version'], ['2026-10-16-campaign-governance-r1','2026-10-20-eligibility-amendments-r1'], true) || !in_array($before['versionColumns'], [0,3], true) || !in_array($before['snapshotColumns'], [0,2], true)) throw new RuntimeException('SCHEMA_DRIFT'); foreach (['SafetyVote_EligibilityAmendments','SafetyVote_EligibilityAmendmentMembers','SafetyVote_EligibilityAmendmentEvents'] as $table) if (table_exists($pdo, $table) && (int)$pdo->query('SELECT COUNT(*) FROM `' . $table . '`')->fetchColumn() !== 0) throw new RuntimeException('EXISTING_AMENDMENT_ROWS');
    $backup = write_backup($dir, $before); execute_script($pdo, '__ELIGIBILITY_MIGRATION_B64__'); $amendmentRows = 0; foreach (['SafetyVote_EligibilityAmendments','SafetyVote_EligibilityAmendmentMembers','SafetyVote_EligibilityAmendmentEvents'] as $table) $amendmentRows += (int)$pdo->query('SELECT COUNT(*) FROM `' . $table . '`')->fetchColumn(); $invalidModes = (int)$pdo->query("SELECT COUNT(*) FROM SafetyVote_CampaignVersions WHERE EligibilityEnrollmentMode NOT IN ('closed_after_open','admin_approval','automatic_rule_match')")->fetchColumn(); $ready = column_count($pdo, 'SafetyVote_CampaignVersions', $versionColumns) === 3 && column_count($pdo, 'SafetyVote_EligibilitySnapshots', $snapshotColumns) === 2 && $before['businessRows'] === business_rows($pdo) && $amendmentRows === 0 && $invalidModes === 0 && setting($pdo, 'schema_version') === '2026-10-20-eligibility-amendments-r1' && setting($pdo, 'eligibility_amendment_enabled') === '0'; if (!$ready) throw new RuntimeException('POSTCHECK_FAILED'); reply(['success' => true, 'schemaReady' => true, 'businessRowsPreserved' => true, 'versionColumns' => 3, 'snapshotColumns' => 2, 'amendmentRows' => 0, 'featureEnabled' => false, 'backup' => $backup]);
