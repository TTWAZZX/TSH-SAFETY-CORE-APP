function table_exists(PDO $pdo, string $table): bool { $s = $pdo->prepare('SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=?'); $s->execute([$table]); return (int)$s->fetchColumn() === 1; }
function column_count(PDO $pdo, string $table, array $columns): int { $marks = implode(',', array_fill(0, count($columns), '?')); $s = $pdo->prepare("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=? AND COLUMN_NAME IN ($marks)"); $s->execute(array_merge([$table], $columns)); return (int)$s->fetchColumn(); }
function business_rows(PDO $pdo): int { $tables = $pdo->query("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_TYPE='BASE TABLE' AND TABLE_NAME LIKE 'SafetyVote\\_%' AND TABLE_NAME NOT IN ('SafetyVote_Settings','SafetyVote_EligibilityAmendments','SafetyVote_EligibilityAmendmentMembers','SafetyVote_EligibilityAmendmentEvents')")->fetchAll(PDO::FETCH_COLUMN); $total = 0; foreach ($tables as $table) { if (!preg_match('/^[A-Za-z0-9_]+$/', (string)$table)) throw new RuntimeException('UNSAFE_TABLE_NAME'); $total += (int)$pdo->query('SELECT COUNT(*) FROM `' . $table . '`')->fetchColumn(); } return $total; }
function execute_script(PDO $pdo, string $encoded): void { $sql = base64_decode($encoded, true); if ($sql === false) throw new RuntimeException('MIGRATION_DECODE_FAILED'); foreach (preg_split('/;\s*(?:\r?\n|$)/', $sql) ?: [] as $statement) { $statement = trim((string)preg_replace('/^(?:--[^\r\n]*(?:\r?\n|$))+/', '', trim($statement))); if ($statement === '') continue; $q = $pdo->prepare($statement); $q->execute(); if ($q->columnCount() > 0) $q->fetchAll(); $q->closeCursor(); } }
function backup_dir(): string { $dir = __DIR__ . DIRECTORY_SEPARATOR . 'private' . DIRECTORY_SEPARATOR . BACKUP_ID; if (!is_dir($dir) && !mkdir($dir, 0700, true) && !is_dir($dir)) throw new RuntimeException('BACKUP_DIRECTORY_FAILED'); file_put_contents($dir . DIRECTORY_SEPARATOR . '.htaccess', "Require all denied\nDeny from all\n", LOCK_EX); return $dir; }
function sql_value(?string $value): string { return $value === null ? 'NULL' : "'" . str_replace("'", "''", $value) . "'"; }
function write_backup(string $dir, array $state): array { $statePath = $dir . DIRECTORY_SEPARATOR . STATE_NAME; file_put_contents($statePath, json_encode($state, JSON_UNESCAPED_SLASHES), LOCK_EX); $sql = "-- Data-preserving Safety Vote eligibility amendment rollback.\nUPDATE SafetyVote_CampaignVersions SET EligibilityEnrollmentMode='closed_after_open',EligibilityEnrollmentUpdatedAt=NULL,EligibilityEnrollmentUpdatedBy='rollback';\n"; foreach (['schema_version','eligibility_amendment_contract','eligibility_amendment_enabled','eligibility_amendment_default_mode','eligibility_amendment_allowed_modes'] as $key) { $value = $state[$key] ?? null; $sql .= $value === null ? "DELETE FROM SafetyVote_Settings WHERE SettingKey='" . $key . "';\n" : "INSERT INTO SafetyVote_Settings(SettingKey,SettingValue,UpdatedBy) VALUES('" . $key . "'," . sql_value((string)$value) . ",'rollback') ON DUPLICATE KEY UPDATE SettingValue=VALUES(SettingValue),UpdatedBy='rollback';\n"; } $path = $dir . DIRECTORY_SEPARATOR . ROLLBACK_NAME; file_put_contents($path, $sql, LOCK_EX); @chmod($path, 0600); return ['relativePath' => 'api/private/' . BACKUP_ID . '/' . ROLLBACK_NAME, 'bytes' => filesize($path), 'sha256' => hash_file('sha256', $path)]; }
function cleanup_files(): array { $dir = __DIR__ . DIRECTORY_SEPARATOR . 'private' . DIRECTORY_SEPARATOR . BACKUP_ID; $removed = []; foreach ([ROLLBACK_NAME, STATE_NAME, '.htaccess', '.used'] as $name) { $path = $dir . DIRECTORY_SEPARATOR . $name; if (is_file($path) && @unlink($path)) $removed[] = $name; } if (is_dir($dir) && @rmdir($dir)) $removed[] = 'backup-directory'; return $removed; }

