<?php
declare(strict_types=1);

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: private, no-store, max-age=0');
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: no-referrer');

const RUN_TOKEN_SHA256 = '__RUN_TOKEN_SHA256__';
const CLEANUP_TOKEN_SHA256 = '__CLEANUP_TOKEN_SHA256__';
const GUARD_NAME = '__GUARD_NAME__';
const BACKUP_ID = '__BACKUP_ID__';
const BACKUP_NAME = 'safety-vote-phase104-rollback.sql';

function reply(array $value, int $status = 200): void
{
    http_response_code($status);
    echo json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    exit;
}

function authorized(string $expected): bool
{
    $token = (string) ($_SERVER['HTTP_X_SAFETY_VOTE_PHASE104_TOKEN'] ?? '');
    return $token !== '' && hash_equals($expected, hash('sha256', $token));
}

function integrity_ready(): bool
{
    $guard = __DIR__ . DIRECTORY_SEPARATOR . GUARD_NAME;
    if (!is_file($guard)) return false;
    $expected = strtolower(trim((string) file_get_contents($guard)));
    return preg_match('/^[a-f0-9]{64}$/', $expected) === 1
        && hash_equals($expected, hash_file('sha256', __FILE__));
}

function connect_database(): PDO
{
    $config = require __DIR__ . '/config.php';
    if (!is_array($config)) throw new RuntimeException('CONFIG_NOT_ARRAY');
    foreach (['db_host', 'db_port', 'db_user', 'db_name'] as $key) {
        if (!array_key_exists($key, $config) || trim((string) $config[$key]) === '') {
            throw new RuntimeException('CONFIG_INCOMPLETE');
        }
    }
    $dsn = 'mysql:host=' . (string) $config['db_host'] . ';port=' . (int) $config['db_port']
        . ';dbname=' . (string) $config['db_name'] . ';charset=utf8mb4';
    return new PDO($dsn, (string) $config['db_user'], (string) $config['db_pass'], [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        PDO::ATTR_EMULATE_PREPARES => false,
    ]);
}

function table_exists(PDO $pdo, string $name): bool
{
    $stmt = $pdo->prepare('SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND LOWER(TABLE_NAME)=LOWER(?)');
    $stmt->execute([$name]);
    return (int) $stmt->fetchColumn() === 1;
}

function column_exists(PDO $pdo, string $table, string $column): bool
{
    $stmt = $pdo->prepare('SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND LOWER(TABLE_NAME)=LOWER(?) AND LOWER(COLUMN_NAME)=LOWER(?)');
    $stmt->execute([$table, $column]);
    return (int) $stmt->fetchColumn() === 1;
}

function index_exists(PDO $pdo, string $table, string $index): bool
{
    $stmt = $pdo->prepare('SELECT COUNT(*) FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND LOWER(TABLE_NAME)=LOWER(?) AND LOWER(INDEX_NAME)=LOWER(?)');
    $stmt->execute([$table, $index]);
    return (int) $stmt->fetchColumn() > 0;
}

function setting(PDO $pdo, string $key): ?string
{
    $stmt = $pdo->prepare('SELECT SettingValue FROM SafetyVote_Settings WHERE SettingKey=?');
    $stmt->execute([$key]);
    $value = $stmt->fetchColumn();
    return $value === false ? null : (string) $value;
}

function business_rows(PDO $pdo): int
{
    $stmt = $pdo->query("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND LEFT(LOWER(TABLE_NAME),11)='safetyvote_' ORDER BY TABLE_NAME");
    $total = 0;
    foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $table) {
        if (strcasecmp((string) $table, 'SafetyVote_Settings') === 0) continue;
        $quoted = '`' . str_replace('`', '``', (string) $table) . '`';
        $total += (int) $pdo->query('SELECT COUNT(*) FROM ' . $quoted)->fetchColumn();
    }
    return $total;
}

function table_count(PDO $pdo): int
{
    return (int) $pdo->query("SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND LEFT(LOWER(TABLE_NAME),11)='safetyvote_'")->fetchColumn();
}

function provider_count(): int
{
    $count = 0;
    foreach (['SAFETY_VOTE_NOTIFICATION_TRANSPORT', 'SAFETY_VOTE_PHASE7_ADAPTER_MODE', 'SAFETY_VOTE_PHASE7_EVIDENCE_MODE'] as $key) {
        $value = getenv($key);
        if ($value !== false && trim((string) $value) !== '') $count++;
    }
    return $count;
}

function ensure_backup_directory(): string
{
    $dir = __DIR__ . DIRECTORY_SEPARATOR . 'private' . DIRECTORY_SEPARATOR . BACKUP_ID;
    if (!is_dir($dir) && !mkdir($dir, 0700, true) && !is_dir($dir)) throw new RuntimeException('BACKUP_DIRECTORY_FAILED');
    file_put_contents($dir . DIRECTORY_SEPARATOR . '.htaccess', "Require all denied\nDeny from all\n", LOCK_EX);
    return $dir;
}

function write_backup(PDO $pdo, string $dir): array
{
    $path = $dir . DIRECTORY_SEPARATOR . BACKUP_NAME;
    $sql = "-- Safety Vote Phase 10.4 guarded rollback\n"
        . "-- Valid only before any Phase 10.4 media/version lineage data is written.\n"
        . "DROP TABLE IF EXISTS `SafetyVote_MediaLinks`;\n"
        . "ALTER TABLE `SafetyVote_CampaignVersions` DROP INDEX `idx_sv_version_parent`;\n"
        . "ALTER TABLE `SafetyVote_CampaignVersions` DROP COLUMN `ChangeReason`, DROP COLUMN `ParentVersionID`;\n"
        . "DELETE FROM `SafetyVote_Settings` WHERE `SettingKey`='phase10_4_contract';\n"
        . "UPDATE `SafetyVote_Settings` SET `SettingValue`='2026-10-08-phase7-r1',`UpdatedBy`='phase104_rollback' WHERE `SettingKey`='schema_version';\n";
    if (file_put_contents($path, $sql, LOCK_EX) === false) throw new RuntimeException('BACKUP_WRITE_FAILED');
    @chmod($path, 0600);
    return ['relativePath' => 'api/private/' . BACKUP_ID . '/' . BACKUP_NAME, 'bytes' => filesize($path), 'sha256' => hash_file('sha256', $path)];
}

function remove_backup_tree(): array
{
    $dir = __DIR__ . DIRECTORY_SEPARATOR . 'private' . DIRECTORY_SEPARATOR . BACKUP_ID;
    $removed = [];
    foreach ([BACKUP_NAME, '.htaccess', '.used'] as $name) {
        $target = $dir . DIRECTORY_SEPARATOR . $name;
        if (is_file($target) && @unlink($target)) $removed[] = $name;
    }
    if (is_dir($dir) && @rmdir($dir)) $removed[] = 'backup-directory';
    $private = dirname($dir);
    if (is_dir($private) && count(scandir($private) ?: []) === 2 && @rmdir($private)) $removed[] = 'empty-private-directory';
    return $removed;
}

function rollback_schema(PDO $pdo): void
{
    if (table_exists($pdo, 'SafetyVote_MediaLinks') && (int) $pdo->query('SELECT COUNT(*) FROM `SafetyVote_MediaLinks`')->fetchColumn() !== 0) throw new RuntimeException('ROLLBACK_BLOCKED_MEDIA_ROWS');
    if (column_exists($pdo, 'SafetyVote_CampaignVersions', 'ParentVersionID') && (int) $pdo->query('SELECT COUNT(*) FROM `SafetyVote_CampaignVersions` WHERE `ParentVersionID` IS NOT NULL OR `ChangeReason` IS NOT NULL')->fetchColumn() !== 0) throw new RuntimeException('ROLLBACK_BLOCKED_VERSION_DATA');
    if (table_exists($pdo, 'SafetyVote_MediaLinks')) $pdo->exec('DROP TABLE `SafetyVote_MediaLinks`');
    if (index_exists($pdo, 'SafetyVote_CampaignVersions', 'idx_sv_version_parent')) $pdo->exec('ALTER TABLE `SafetyVote_CampaignVersions` DROP INDEX `idx_sv_version_parent`');
    if (column_exists($pdo, 'SafetyVote_CampaignVersions', 'ChangeReason')) $pdo->exec('ALTER TABLE `SafetyVote_CampaignVersions` DROP COLUMN `ChangeReason`');
    if (column_exists($pdo, 'SafetyVote_CampaignVersions', 'ParentVersionID')) $pdo->exec('ALTER TABLE `SafetyVote_CampaignVersions` DROP COLUMN `ParentVersionID`');
    $pdo->prepare("DELETE FROM SafetyVote_Settings WHERE SettingKey='phase10_4_contract'")->execute();
    $pdo->prepare("UPDATE SafetyVote_Settings SET SettingValue='2026-10-08-phase7-r1',UpdatedBy='phase104_rollback' WHERE SettingKey='schema_version'")->execute();
}

if (!integrity_ready()) reply(['success' => false, 'code' => 'HELPER_INTEGRITY_FAILED'], 409);
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') reply(['success' => false, 'code' => 'METHOD_NOT_ALLOWED'], 405);
$action = strtolower(trim((string) ($_SERVER['HTTP_X_SAFETY_VOTE_PHASE104_ACTION'] ?? '')));

if ($action === 'cleanup') {
    if (!authorized(CLEANUP_TOKEN_SHA256)) reply(['success' => false, 'code' => 'UNAUTHORIZED'], 401);
    $removed = remove_backup_tree();
    $guard = __DIR__ . DIRECTORY_SEPARATOR . GUARD_NAME;
    if (is_file($guard)) @unlink($guard);
    $self = __FILE__;
    register_shutdown_function(static function () use ($self): void { @unlink($self); });
    reply(['success' => true, 'valuesSuppressed' => true, 'removedCount' => count($removed), 'selfRemovalScheduled' => true]);
}

if (!authorized(RUN_TOKEN_SHA256)) reply(['success' => false, 'code' => 'UNAUTHORIZED'], 401);
$stage = 'connect';
try {
    $pdo = connect_database();
    $pdo->exec("SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'");
    if ($action === 'rollback') {
        $stage = 'rollback';
        rollback_schema($pdo);
        reply(['success' => true, 'valuesSuppressed' => true, 'tableCount' => table_count($pdo), 'businessRows' => business_rows($pdo), 'moduleEnabled' => setting($pdo, 'module_enabled') === '1', 'integrationsEnabled' => setting($pdo, 'phase7_integrations_enabled') === '1', 'schemaVersionRestored' => setting($pdo, 'schema_version') === '2026-10-08-phase7-r1']);
    }
    if ($action === 'resume') {
        $stage = 'resume_precheck';
        $mediaRows = table_exists($pdo, 'SafetyVote_MediaLinks') ? (int) $pdo->query('SELECT COUNT(*) FROM `SafetyVote_MediaLinks`')->fetchColumn() : -1;
        $lineageRows = column_exists($pdo, 'SafetyVote_CampaignVersions', 'ParentVersionID') ? (int) $pdo->query('SELECT COUNT(*) FROM `SafetyVote_CampaignVersions` WHERE `ParentVersionID` IS NOT NULL OR `ChangeReason` IS NOT NULL')->fetchColumn() : -1;
        if (table_count($pdo) !== 40 || setting($pdo, 'schema_version') !== '2026-10-09-phase10.4-r1' || setting($pdo, 'phase10_4_contract') !== '2026-10-09-safety-vote-phase10.4-r1') throw new RuntimeException('RESUME_SCHEMA_NOT_READY');
        if (setting($pdo, 'module_enabled') !== '1' || setting($pdo, 'phase7_integrations_enabled') !== '0' || provider_count() !== 0) throw new RuntimeException('RESUME_POSTURE_FAILED');
        if ($mediaRows !== 0 || $lineageRows !== 0) throw new RuntimeException('RESUME_PHASE104_DATA_PRESENT');
        $dir = ensure_backup_directory();
        $used = @fopen($dir . DIRECTORY_SEPARATOR . '.used', 'x');
        if ($used === false) throw new RuntimeException('TOKEN_ALREADY_USED');
        fwrite($used, gmdate('c')); fclose($used);
        $backup = write_backup($pdo, $dir);
        reply(['success' => true, 'valuesSuppressed' => true, 'helperIntegrityVerified' => true, 'tableCount' => 40, 'businessRows' => business_rows($pdo), 'campaignCount' => (int) $pdo->query('SELECT COUNT(*) FROM `SafetyVote_Campaigns`')->fetchColumn(), 'phase104DataRows' => 0, 'moduleEnabled' => true, 'integrationsEnabled' => false, 'configuredProviders' => 0, 'schemaVersionReady' => true, 'backup' => $backup]);
    }
    if ($action !== 'migrate') reply(['success' => false, 'code' => 'UNKNOWN_ACTION'], 400);

    $stage = 'precheck';
    if (table_count($pdo) !== 39) throw new RuntimeException('PRECHECK_SCHEMA');
    $businessBefore = business_rows($pdo);
    if (setting($pdo, 'module_enabled') !== '1' || setting($pdo, 'phase7_integrations_enabled') !== '0') throw new RuntimeException('PRECHECK_SETTINGS');
    if (setting($pdo, 'schema_version') !== '2026-10-08-phase7-r1' || setting($pdo, 'phase10_4_contract') !== null) throw new RuntimeException('PRECHECK_VERSION');
    if (provider_count() !== 0) throw new RuntimeException('PRECHECK_PROVIDERS');
    if (table_exists($pdo, 'SafetyVote_MediaLinks') || column_exists($pdo, 'SafetyVote_CampaignVersions', 'ParentVersionID') || column_exists($pdo, 'SafetyVote_CampaignVersions', 'ChangeReason')) throw new RuntimeException('PRECHECK_DRIFT');

    $stage = 'backup';
    $dir = ensure_backup_directory();
    $used = @fopen($dir . DIRECTORY_SEPARATOR . '.used', 'x');
    if ($used === false) throw new RuntimeException('TOKEN_ALREADY_USED');
    fwrite($used, gmdate('c')); fclose($used);
    $backup = write_backup($pdo, $dir);

    $stage = 'columns';
    $pdo->exec('ALTER TABLE `SafetyVote_CampaignVersions` ADD COLUMN `ParentVersionID` BIGINT NULL AFTER `CampaignID`');
    $pdo->exec('ALTER TABLE `SafetyVote_CampaignVersions` ADD COLUMN `ChangeReason` VARCHAR(500) NULL AFTER `ParentVersionID`');
    $stage = 'index';
    $pdo->exec('CREATE INDEX `idx_sv_version_parent` ON `SafetyVote_CampaignVersions` (`ParentVersionID`)');
    $stage = 'media_table';
    $pdo->exec("CREATE TABLE `SafetyVote_MediaLinks` (`id` BIGINT NOT NULL AUTO_INCREMENT,`CampaignID` BIGINT NOT NULL,`CampaignVersionID` BIGINT NOT NULL,`ScopeType` VARCHAR(16) NOT NULL,`QuestionCode` VARCHAR(60) NULL,`OptionCode` VARCHAR(60) NULL,`MediaType` VARCHAR(16) NOT NULL,`Provider` VARCHAR(24) NOT NULL DEFAULT 'external',`Url` VARCHAR(1000) NOT NULL,`EmbedUrl` VARCHAR(1000) NULL,`Title` VARCHAR(200) NULL,`SortOrder` INT NOT NULL DEFAULT 1,`Status` VARCHAR(16) NOT NULL DEFAULT 'Active',`CreatedBy` VARCHAR(20) NOT NULL,`UpdatedBy` VARCHAR(20) NOT NULL,`CreatedAt` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,`UpdatedAt` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,PRIMARY KEY (`id`),KEY `idx_sv_media_version` (`CampaignVersionID`,`Status`,`SortOrder`),CONSTRAINT `fk_sv_media_campaign` FOREIGN KEY (`CampaignID`) REFERENCES `SafetyVote_Campaigns` (`id`),CONSTRAINT `fk_sv_media_version` FOREIGN KEY (`CampaignVersionID`) REFERENCES `SafetyVote_CampaignVersions` (`id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
    $stage = 'settings';
    $stmt = $pdo->prepare("INSERT INTO SafetyVote_Settings(SettingKey,SettingValue,UpdatedBy) VALUES(?,?,?) ON DUPLICATE KEY UPDATE SettingValue=VALUES(SettingValue),UpdatedBy=VALUES(UpdatedBy)");
    $stmt->execute(['schema_version', '2026-10-09-phase10.4-r1', 'phase104_migrate']);
    $stmt->execute(['phase10_4_contract', '2026-10-09-safety-vote-phase10.4-r1', 'phase104_migrate']);

    $stage = 'postcheck';
    $businessAfter = business_rows($pdo);
    $pass = table_count($pdo) === 40 && $businessAfter === $businessBefore
        && setting($pdo, 'module_enabled') === '1' && setting($pdo, 'phase7_integrations_enabled') === '0'
        && setting($pdo, 'schema_version') === '2026-10-09-phase10.4-r1'
        && provider_count() === 0 && table_exists($pdo, 'SafetyVote_MediaLinks')
        && column_exists($pdo, 'SafetyVote_CampaignVersions', 'ParentVersionID')
        && column_exists($pdo, 'SafetyVote_CampaignVersions', 'ChangeReason');
    if (!$pass) throw new RuntimeException('POSTCHECK_FAILED');
    reply(['success' => true, 'valuesSuppressed' => true, 'helperIntegrityVerified' => true, 'tableCountBefore' => 39, 'tableCountAfter' => 40, 'businessRowsBefore' => $businessBefore, 'businessRowsAfter' => $businessAfter, 'businessRowsPreserved' => $businessAfter === $businessBefore, 'moduleEnabled' => true, 'integrationsEnabled' => false, 'configuredProviders' => 0, 'schemaVersionReady' => true, 'backup' => $backup]);
} catch (Throwable $error) {
    $rollback = false;
    try {
        if (isset($pdo) && $pdo instanceof PDO && $action === 'migrate' && $stage !== 'precheck' && $stage !== 'backup') {
            rollback_schema($pdo);
            $rollback = true;
        }
    } catch (Throwable $ignored) { $rollback = false; }
    reply(['success' => false, 'code' => 'PHASE104_MIGRATION_FAILED', 'failureStage' => $stage, 'rollbackRestoredPhase7' => $rollback, 'valuesSuppressed' => true], 500);
}
