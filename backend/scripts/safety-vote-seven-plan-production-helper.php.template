 $used=@fopen($dir.DIRECTORY_SEPARATOR.'.used','x');if($used===false)throw new RuntimeException('TOKEN_ALREADY_USED');fwrite($used,gmdate('c'));fclose($used);$campaignColumns=['IsHidden','HiddenAt','HiddenBy','HideReason','IsTest','TestMarkedAt','TestMarkedBy','TestReason','ArchivedFromStatus','ArchivedBy','ArchiveReason'];$versionColumns=['MaxParticipationAttempts'];$before=['schema_version'=>setting($pdo,'schema_version'),'participation_attempts_contract'=>setting($pdo,'participation_attempts_contract'),'campaign_governance_contract'=>setting($pdo,'campaign_governance_contract'),'campaignColumns'=>column_count($pdo,'SafetyVote_Campaigns',$campaignColumns),'versionColumns'=>column_count($pdo,'SafetyVote_CampaignVersions',$versionColumns),'purgeTable'=>table_exists($pdo,'SafetyVote_CampaignPurgeLog'),'businessRows'=>business_rows($pdo)];if(!in_array($before['campaignColumns'],[0,11],true)||!in_array($before['versionColumns'],[0,1],true))throw new RuntimeException('SCHEMA_DRIFT');$backup=write_backup($dir,$before);execute_script($pdo,'__PARTICIPATION_MIGRATION_B64__');execute_script($pdo,'__GOVERNANCE_MIGRATION_B64__');$afterRows=business_rows($pdo);$purgeRows=(int)$pdo->query('SELECT COUNT(*) FROM SafetyVote_CampaignPurgeLog')->fetchColumn();$invalidAttempts=(int)$pdo->query('SELECT COUNT(*) FROM SafetyVote_CampaignVersions WHERE MaxParticipationAttempts<1 OR MaxParticipationAttempts>10')->fetchColumn();$flagged=(int)$pdo->query('SELECT COUNT(*) FROM SafetyVote_Campaigns WHERE IsHidden<>0 OR IsTest<>0')->fetchColumn();$ready=column_count($pdo,'SafetyVote_Campaigns',$campaignColumns)===11&&column_count($pdo,'SafetyVote_CampaignVersions',$versionColumns)===1&&table_exists($pdo,'SafetyVote_CampaignPurgeLog')&&$before['businessRows']===$afterRows&&$purgeRows===0&&$invalidAttempts===0&&$flagged===0&&setting($pdo,'schema_version')==='2026-10-16-campaign-governance-r1';if(!$ready)throw new RuntimeException('POSTCHECK_FAILED');reply(['success'=>true,'schemaReady'=>true,'bus