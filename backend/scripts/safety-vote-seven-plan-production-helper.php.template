function write_backup(string $dir,array $state):array{$statePath=$dir.DIRECTORY_SEPARATOR.STATE_NAME;file_put_contents($statePath,json_encode($state,JSON_UNESCAPED_SLASHES),LOCK_EX);$sql="-- Data-preserving Safety Vote seven-plan rollback.\nUPDATE SafetyVote_CampaignVersions SET MaxParticipationAttempts=1 WHERE MaxParticipationAttempts<>1;\nUPDATE SafetyVote_Campaigns SET IsHidden=0,HiddenAt=NULL,HiddenBy=NULL,HideReason=NULL,IsTest=0,TestMarkedAt=NULL,TestMarkedBy=NULL,TestReason=NULL,ArchivedFromStatus=NULL,ArchivedBy=NULL,ArchiveReason=NULL;\n";foreach(['schema_version','participation_attempts_contract','campaign_governance_contract']as$key){$value=$state[$key]??null;$sql.=$value===null?"DELETE FROM SafetyVote_Settings WHERE SettingKey='".$key."';\n":"INSERT INTO SafetyVote_Settings(SettingKey,SettingValue,UpdatedBy) VALUES('".$key."',".sql_value((string)$value).",'rollback') ON DUPLICATE KEY UPDATE SettingValue=VALUES(SettingValue),UpdatedBy='rollback';\n";}$path=$dir.DIRECTORY_SEPARATOR.ROLLBACK_NAME;file_put_contents($path,$sql,LOCK_EX);@chmod($path,0600);return['relativePath'=>'api/private/'.BACKUP_ID.'/'.ROLLBACK_NAME,'bytes'=>filesize($path),'sha256'=>hash_file('sha256',$path)];}
function cleanup_files():array{$dir=__DIR__.DIRECTORY_SEPARATOR.'private'.DIRECTORY_SEPARATOR.BACKUP_ID;$removed=[];foreach([ROLLBACK_NAME,STATE_NAME,'.htaccess','.used']as$name){$p=$dir.DIRECTORY_SEPARATOR.$name;if(is_file($p)&&@unlink($p))$removed[]=$name;}if(is_dir($dir)&&@rmdir($dir))$removed[]='backup-directory';return$removed;}
