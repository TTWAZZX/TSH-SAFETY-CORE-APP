function setting(PDO $pdo,string $key):?string{$s=$pdo->prepare('SELECT SettingValue FROM SafetyVote_Settings WHERE SettingKey=?');$s->execute([$key]);$v=$s->fetchColumn();return$v===false?null:(string)$v;}
