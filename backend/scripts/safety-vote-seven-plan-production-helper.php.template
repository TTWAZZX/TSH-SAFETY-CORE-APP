function business_rows(PDO $pdo):int{$tables=$pdo->query("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_TYPE='BASE TABLE' AND TABLE_NAME LIKE 'SafetyVote\\_%' AND TABLE_NAME NOT IN ('SafetyVote_Settings','SafetyVote_CampaignPurgeLog')")->fetchAll(PDO::FETCH_COLUMN);$total=0;foreach($tables as$table){if(!preg_match('/^[A-Za-z0-9_]+$/',(string)$table))throw new RuntimeException('UNSAFE_TABLE_NAME');$total+=(int)$pdo->query('SELECT COUNT(*) FROM `'.$table.'`')->fetchColumn();}return$total;}
